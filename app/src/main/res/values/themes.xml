<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the window content; this theme only sets the pre-Compose window. -->
    <style name="Theme.Audiops" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Android 12-style splash screen on every supported version (core-splashscreen). -->
    <style name="Theme.Audiops.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Audiops</item>
    </style>
</resources>
